# SprintParty environment variables
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# ServiceNow integration (temporary username/password auth — OAuth comes later)
# ---------------------------------------------------------------------------
# These are read ONLY on the server (API route /api/servicenow/stories).
# They are never bundled into browser code.

# Base URL of your ServiceNow instance / PDI. No trailing slash.
# Example: https://dev123456.service-now.com
SERVICENOW_INSTANCE_URL=

# A ServiceNow user with read access to the `rm_story` table.
SERVICENOW_USERNAME=

# That user's password. Server-side only.
SERVICENOW_PASSWORD=
